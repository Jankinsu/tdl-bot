# If unset, the bot uses ~/Downloads/telegram.
# Paths must be absolute; ~ and $HOME are not expanded in this file.
# TDL_BOT_MEDIA_DIR=/home/your-user/Downloads/telegram
TDL_BOT_REQUIRED_MOUNT=

# Once the USB drive is mounted at /mnt/media, set both:
# TDL_BOT_MEDIA_DIR=/mnt/media/telegram
# TDL_BOT_REQUIRED_MOUNT=/mnt/media

# Throne mixed listener: HTTP for Bot API and SOCKS5 for tdl.
TDL_BOT_API_PROXY=http://127.0.0.1:2080
TDL_PROXY=socks5://127.0.0.1:2080
